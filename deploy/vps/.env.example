# Copy to deploy/vps/.env (same folder) and fill in. Never commit the real file.

# Public address of the app. sslip.io names point to the IP inside them, so no DNS is needed.
# Must not be one of the other project's names (app./api./s3.189-72-151-212.sslip.io).
APP_DOMAIN=zivoplus.189-72-151-212.sslip.io
# Old addresses that forward permanently to APP_DOMAIN (comma-separated), e.g. after moving from
# zivohotels.com: REDIRECT_DOMAINS=staging.zivohotels.com. Each must point to this server in DNS.
REDIRECT_DOMAINS=

# Name of the existing Caddy container (docker ps)
CADDY_CONTAINER=staging-caddy

# Database password: run `openssl rand -hex 16` and paste
DB_PASSWORD=

# 64 random characters: run `openssl rand -hex 32` and paste
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay TEST keys (never live keys on staging)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: without it OTP and booking emails are not sent
RESEND_API_KEY=
EMAIL_FROM="ZivoPlus Staging <noreply@zivoplus.com>"

# Sign-in codes: "true" shows email codes on screen instead of sending them. Use only until the
# Resend domain is verified; never on the live site.
EMAIL_TEST_MODE=false
# Admin alert emails (refund failed, property submitted), comma-separated
ADMIN_ALERT_EMAILS=

# SMS (sign-in codes, booking texts): "test" shows codes on screen and sends nothing.
# msg91: MSG91_AUTH_KEY + MSG91_OTP_TEMPLATE_ID (DLT-approved, code as ##OTP##), optional
# MSG91_SMS_TEMPLATE_ID (variable ##message##). twilio: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM.
SMS_PROVIDER=test
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SMS_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# "Continue with Google": the OAuth web client id from Google Cloud (APIs & Services ->
# Credentials). Add the site address under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Company details printed on invoices and vouchers (legal name, GSTIN, PAN, CIN, registered
# address) and the support contacts are already set in docker-compose.yml; a value here overrides them.

# Optional: map in property onboarding
VITE_GOOGLE_MAPS_API_KEY=

# Speed and capacity (optional; the defaults suit an 8-core VPS shared with another project).
# WEB_CONCURRENCY: server processes, one per CPU core used. DB_POOL_PER_PROCESS: database
# connections each one may open (WEB_CONCURRENCY x DB_POOL_PER_PROCESS must stay under 180).
WEB_CONCURRENCY=4
DB_POOL_PER_PROCESS=10
# Proxies in front of the API, so rate limits see the visitor's real address
# (2 = Caddy -> website -> API). Leave it at 2, also with Cloudflare.
TRUST_PROXY=2
# Cloudflare in front of the site: set true once its proxy (orange cloud) is on, then deploy.
# See CLOUDFLARE.md.
BEHIND_CLOUDFLARE=false
