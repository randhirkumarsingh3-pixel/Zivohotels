{
  "name": "zivoplus-backend",
  "version": "1.0.0",
  "description": "Node.js Express backend for ZivoPlus",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node cluster.js",
    "dev": "node --watch server.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "worker:integrity": "node workers/runWorker.js integrity",
    "worker:experiment": "node workers/runWorker.js experiment",
    "worker:pricing": "node workers/runWorker.js pricing",
    "worker:pricing-trainer": "node workers/runWorker.js pricing-trainer",
    "worker:finance": "node workers/runWorker.js finance",
    "worker:inventory": "node workers/runWorker.js inventory",
    "worker:cleanup": "node workers/runWorker.js cleanup",
    "worker:email": "node workers/runWorker.js email",
    "worker:notification": "node workers/runWorker.js notification",
    "worker:analytics": "node workers/runWorker.js analytics",
    "worker:report": "node workers/runWorker.js report",
    "test:unit": "mocha 'tests/unit/**/*.test.js'",
    "test:smoke": "mocha tests/smoke/smoke.test.js --exit",
    "test:e2e": "mocha tests/e2e/booking.e2e.test.js tests/e2e/auth.e2e.test.js tests/e2e/hourly.e2e.test.js tests/e2e/roles.e2e.test.js tests/e2e/seo.e2e.test.js tests/e2e/google.e2e.test.js tests/e2e/reports.e2e.test.js tests/e2e/financeDocs.e2e.test.js tests/e2e/security.e2e.test.js tests/e2e/propertyHub.e2e.test.js tests/e2e/dataProtection.e2e.test.js tests/e2e/capacity.e2e.test.js tests/e2e/guestJourney.e2e.test.js tests/e2e/documents.e2e.test.js tests/e2e/roomConfig.e2e.test.js tests/e2e/adminOps.e2e.test.js tests/e2e/onboardingAgreement.e2e.test.js tests/e2e/leegality.e2e.test.js tests/e2e/business.e2e.test.js tests/e2e/partnerHub.e2e.test.js --exit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@prisma/client": "^5.11.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.1",
    "fflate": "^0.8.2",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "puppeteer": "^25.17.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.2",
    "razorpay": "^2.9.6",
    "redis": "^6.3.1",
    "resend": "^6.12.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "axios": "^1.18.1",
    "chai": "^6.2.2",
    "minimist": "^1.2.8",
    "mocha": "^11.7.6",
    "prisma": "^5.11.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
