# Copy to backend/.env and fill in. Never commit real values.
# The server refuses to start if a REQUIRED value is missing (see config/env.js).

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Local development: a PostgreSQL on this machine (e.g. Postgres.app).
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/zivohotels"
# Used by Prisma CLI (migrate / db push). Locally, the same as DATABASE_URL.
DIRECT_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/zivohotels"

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Production: at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me-local-dev-only"
JWT_EXPIRES_IN="7d"

# ── Payments (REQUIRED) — use Razorpay TEST keys locally, never live keys ─────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
# Optional locally; without it Razorpay webhooks are rejected
RAZORPAY_WEBHOOK_SECRET=""

# ── Email (optional locally) ──────────────────────────────────────────────────
# Without it OTP / booking emails are not sent
RESEND_API_KEY=""
EMAIL_FROM="ZivoHotels <noreply@zivohotels.com>"

# ── File storage ──────────────────────────────────────────────────────────────
# Leave unset locally: uploads are saved to backend/public/uploads.
# If set (outside production), uploads go to Google Cloud Storage instead.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ── Misc ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
OTP_EXPIRY_MINUTES=10

# Test-account passwords used by `npm run db:seed` (local only)
# SEED_ADMIN_PASSWORD=""
# SEED_OWNER_PASSWORD=""
# SEED_CUSTOMER_PASSWORD=""
