# Copy to backend/.env and fill in. Never commit real values.
# The server refuses to start if a REQUIRED value is missing (see config/env.js).

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Local development: a PostgreSQL on this machine (e.g. Postgres.app).
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/zivohotels"
# Used by Prisma CLI (migrate / db push). Locally, the same as DATABASE_URL.
DIRECT_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/zivohotels"

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Production: at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me-local-dev-only"
JWT_EXPIRES_IN="7d"

# ── Payments (REQUIRED) — use Razorpay TEST keys locally, never live keys ─────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
# Optional locally; without it Razorpay webhooks are rejected
RAZORPAY_WEBHOOK_SECRET=""

# ── Email (optional locally) ──────────────────────────────────────────────────
# Without it OTP / booking emails are not sent
RESEND_API_KEY=""
EMAIL_FROM="ZivoHotels <noreply@zivohotels.com>"

# Sign-in codes: "true" shows email codes on screen instead of sending them. Use only until the
# Resend domain is verified; never on the live site.
EMAIL_TEST_MODE=false
# Admin alert emails (refund failed, property submitted), comma-separated
ADMIN_ALERT_EMAILS=

# SMS (sign-in codes, booking texts): "test" shows codes on screen and sends nothing.
# msg91: MSG91_AUTH_KEY + MSG91_OTP_TEMPLATE_ID (DLT-approved, code as ##OTP##), optional
# MSG91_SMS_TEMPLATE_ID (variable ##message##). twilio: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM.
SMS_PROVIDER=test
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SMS_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# "Continue with Google": the OAuth web client id from Google Cloud (APIs & Services ->
# Credentials). Add the site address under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# ── File storage ──────────────────────────────────────────────────────────────
# Leave unset locally: uploads are saved to backend/public/uploads.
# If set (outside production), uploads go to Google Cloud Storage instead.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# KYC documents (PAN, GST, cheques) are stored privately: locally in backend/private_uploads/,
# in the cloud in this bucket. Use a bucket WITHOUT public read access; if unset, the public-read
# media bucket is used (files get unguessable names, but that is only a fallback).
# GCS_KYC_BUCKET="zivohotels-kyc-prod"

# Where uploads are stored: "local" (this server's disk) or "gcs" (Google Cloud Storage).
# Unset = local in development, GCS in production. Self-hosted servers (VPS) use "local".
# STORAGE_DRIVER=local

# ── Server ────────────────────────────────────────────────────────────────────
# Extra browser origins allowed to call the API (comma-separated), e.g. a staging domain.
# CORS_ORIGINS="https://staging.zivohotels.com"
# Address to listen on. Behind Nginx on a VPS use 127.0.0.1 so the port isn't public.
# HOST=127.0.0.1
# Number of reverse proxies in front of the API (default 1). Caddy -> web container -> API = 2.
# TRUST_PROXY=1

# ── Misc ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
OTP_EXPIRY_MINUTES=10

# Test-account passwords used by `npm run db:seed` (local only)
# SEED_ADMIN_PASSWORD=""
# SEED_OWNER_PASSWORD=""
# SEED_CUSTOMER_PASSWORD=""

# ZivoHotels' own GSTIN (or just its 2-digit state code in ZIVO_GST_STATE_CODE). Decides whether GST
# on commission is CGST+SGST (hotel in the same state) or IGST. Without it, IGST is always used.
ZIVO_GSTIN=

# Shown on booking / hotelier vouchers (each line appears only when set)
ZIVO_LEGAL_NAME=
ZIVO_PAN=
ZIVO_CIN=
ZIVO_ADDRESS=
ZIVO_SUPPORT_EMAIL=
ZIVO_SUPPORT_PHONE=

# Chrome used to render PDFs (invoices, vouchers) if Puppeteer's bundled one can't run (e.g. macOS 12).
# Left empty, an installed Google Chrome is used automatically when needed.
PUPPETEER_EXECUTABLE_PATH=

# TESTING ONLY: fixed email OTP (ignored when NODE_ENV=production). Leave unset in production.
# TEST_OTP=123456
