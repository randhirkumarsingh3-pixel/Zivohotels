  apiKeyHash        String? // SHA-256 of the key the channel manager uses to push ARI to ZivoPlus
  apiKeyHint        String? // last 4 characters, to recognise the key
  status            String    @default("PENDING") // PENDING | ACTIVE | PAUSED
