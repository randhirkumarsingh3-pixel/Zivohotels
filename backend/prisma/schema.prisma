generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String         @id @default(uuid())
  name                String
  email               String         @unique
  password            String
  role                Role           @default(CUSTOMER)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  phone               String?
  /// When the email / phone was confirmed with a code (sign-up). Older accounts: null
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  /// Google account id ("sub") for "Continue with Google"
  googleId            String?        @unique
  inviteToken         String?
  inviteExpiry        DateTime?
  /// "Forgot password": SHA-256 of the emailed token, valid until passwordResetExpiry (1 hour)
  passwordResetToken  String?        @unique
  passwordResetExpiry DateTime?
  passwordChangedAt   DateTime?
  mustChangePassword  Boolean?       @default(false)
  status              UserStatus?    @default(ACTIVE)
  loyalty             Int?           @default(0)
  tokenVersion        Int            @default(1)
  lastLogin           DateTime?
  lastActiveAt        DateTime?
  bookings            Booking[]
  couponUsages        CouponUsage[]
  hotels              Hotel[]        @relation("PrimaryOwner")
  loyaltyWallet       LoyaltyWallet?
  reviews             Review[]
  staffMemberships    StaffMember[]  @relation("StaffUser")
}

model Hotel {
  id                    String          @id @default(uuid())
  name                  String
  location              String
  city                  String
  rating                Float           @default(0)
  reviews               Int             @default(0)
  /// What's nearby (onboarding Location step): [{ id, name, category: TRANSIT | ATTRACTION |
  /// LANDMARK | RESTAURANT, type, lat, lng, distanceKm, source: OSM | MANUAL, visible }]
  nearbyPlaces          Json            @default("[]")
  /// When nearby places were filled automatically from the map pin (once, for the owner to review)
  nearbyAutoFilledAt    DateTime?
  /// Member price: % off for signed-in members, set by the hotel in the extranet (0 = not offered)
  memberDiscountPercent Float           @default(0)
  /// Guest review score (average of published reviews, 1-5) and count; rating is the star category
  reviewScore           Float?
  reviewCount           Int             @default(0)
  reviewAspects         Json?
  amenities             Json            @default("[]")
  description           String?         @default("")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  ownerId               String
  latitude              Float?
  longitude             Float?
  landmark              String?
  state                 String?
  country               String?         @default("India")
  pincode               String?
  type                  String?         @default("hotel")
  status                PropertyStatus? @default(DRAFT)
  statusReason          String?
  statusUpdatedBy       String?
  statusUpdatedAt       DateTime?

  // Enterprise PLMS Tracking
  createdBy  String?
  updatedBy  String?
  reviewedBy String?
  approvedBy String?
  reviewNote String?

  mode           PropertyMode @default(INTERNAL)
  onboardingStep Int          @default(1)

  // Identity & KYC
  legalName         String?
  brandName         String?
  gstin             String?
  pan               String?
  incorporationType String? @default("INDIVIDUAL") // INDIVIDUAL, PARTNERSHIP, PVT_LTD

  // Scoring
  mediaScore            Float @default(0)
  complianceScore       Int   @default(0)
  revenueReadinessScore Int   @default(0)
  readinessBreakdown    Json  @default("{}")

  checkInTime         String?  @default("14:00")
  checkOutTime        String?  @default("11:00")
  policies            Json     @default("[]")
  isDeleted           Boolean? @default(false)
  channelProvider     String?
  integrationMode     String   @default("INTERNAL")
  integrationSettings Json?    @default("{}")
  cmSyncStatus        String?  @default("INACTIVE")

  creditScore           Float     @default(700)
  dynamicCommissionRate Float     @default(15.0)
  isThrottled           Boolean   @default(false)
  competitivenessRating Float     @default(0.5)
  healthScore           Int       @default(70)
  payoutCycle           String    @default("T+2")
  activationDate        DateTime?
  lastAuditAt           DateTime?

  // Relations
  bookings           Booking[]
  cancellationPolicy CancellationPolicy?
  owner              User                @relation("PrimaryOwner", fields: [ownerId], references: [id])
  staff              StaffMember[]
  media              HotelImage[]
  reviewList         Review[]
  roomTypes          RoomType[]
  kycRecords         KYCRecord[]
  tasks              PropertyTask[]
  agreements         PropertyAgreement[]
  channelMappings    ChannelMapping[]
  lead               PropertyLead?
  policyRecords      HotelPolicy[]
  stayRequests       StayRequest[]
  /// Hourly stays: { enabled, approved (by ZivoPlus), openFrom "08:00", openTo "21:00",
  /// durations [3,6,9,12], cleaningMinutes, leadMinutes, freeCancelHours, extraHourPrice, allowOffers }
  hourlySettings     Json?

  @@index([ownerId])
  @@index([city])
  @@index([status])
  @@index([state])
  @@index([country])
  @@index([pincode])
}

model RoomType {
  id                String             @id @default(uuid())
  name              String
  description       String
  totalInventory    Int
  amenities         Json               @default("[]")
  hotelId           String
  code              String?            @default("")
  maxOccupancy      Int?               @default(2)
  baseOccupancy     Int?               @default(2)
  bedType           String?
  roomSize          String?
  viewType          String?
  isActive          Boolean?           @default(true)
  extraBedAllowed   Boolean            @default(false)
  maxExtraBeds      Int?
  bookings          Booking[]
  bookingRooms      BookingRoom[]
  inventories       Inventory[]
  ratePlans         RatePlan[]
  hotel             Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  images            RoomTypeImage[]
  /// Hourly stays for this room type: on/off, rooms set aside for hourly use each day, and the
  /// price of each duration in hours ({ "3": 1299, "6": 1999 })
  hourlyEnabled     Boolean            @default(false)
  hourlyRooms       Int                @default(0)
  hourlyPrices      Json?
  hourlyAllocations HourlyAllocation[]

  @@unique([hotelId, code])
}

model HotelImage {
  id         String          @id @default(uuid())
  url        String
  hotelId    String
  tags       String[]
  category   String
  isPrimary  Boolean         @default(false)
  aiScore    Float?
  aiAnalysis Json?           @default("{}")
  createdAt  DateTime        @default(now())
  hotel      Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomLinks  RoomTypeImage[]

  @@index([hotelId, category])
}

model RoomTypeImage {
  id         String     @id @default(uuid())
  roomTypeId String
  imageId    String
  isPrimary  Boolean    @default(false)
  image      HotelImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, imageId])
  @@index([roomTypeId])
}

model RatePlan {
  id                 String             @id @default(uuid())
  name               String
  mealPlan           MealPlan?          @default(NONE)
  cancellationPolicy String?
  basePrice          Decimal            @db.Decimal(12, 2)
  isActive           Boolean?           @default(true)
  roomTypeId         String
  extraAdultPrice    Decimal?           @default(0) @db.Decimal(12, 2)
  extraBedIncluded   Boolean            @default(false)
  extraBedPrice      Decimal?           @db.Decimal(12, 2)
  extraChildPrice    Decimal?           @default(0) @db.Decimal(12, 2)
  mealPriceAdult     Decimal?           @db.Decimal(12, 2)
  mealPriceChild     Decimal?           @db.Decimal(12, 2)
  isConfigured       Boolean            @default(false)
  bookings           Booking[]
  bookingRooms       BookingRoom[]
  occupancyPricing   OccupancyPricing[]
  dailyRates         DailyRate[]
  roomType           RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
}

/// Price of a rate plan for one night, overriding its base price (set in Inventory & Rates or by
/// the property's channel manager). Base occupancy; extra guest / bed / meal charges still apply.
model DailyRate {
  id         String   @id @default(uuid())
  ratePlanId String
  date       DateTime
  price      Decimal  @db.Decimal(12, 2)
  source     String   @default("MANUAL") // MANUAL | CHANNEL_MANAGER | DYNAMIC
  updatedAt  DateTime @updatedAt
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, date])
}

model OccupancyPricing {
  id         String   @id @default(uuid())
  ratePlanId String
  occupancy  Int
  price      Decimal  @db.Decimal(12, 2)
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, occupancy])
}

model Booking {
  id                  String                 @id @default(uuid())
  bookingRef          String                 @unique
  guestName           String
  guestEmail          String
  guestPhone          String
  // Optional business details for a GST invoice in the company's name
  guestCompanyName    String?
  guestCompanyGstin   String?
  guestCompanyAddress String?
  checkIn             DateTime
  checkOut            DateTime
  guests              Int
  rooms               Int
  /// Part of the amount due now that the guest paid with Zivo Cash (included in paidAmount once
  /// the booking is paid; returned to the wallet if the booking is never completed)
  walletAmount        Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal                @db.Decimal(12, 2)
  status              BookingStatus          @default(PENDING)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  hotelId             String
  roomTypeId          String
  userId              String?
  razorpayOrderId     String?
  razorpayPaymentId   String?
  razorpaySignature   String?
  paidAmount          Decimal?               @default(0) @db.Decimal(12, 2)
  remainingAmount     Decimal?               @default(0) @db.Decimal(12, 2)
  expiresAt           DateTime?
  paymentType         PaymentType?           @default(PREPAID)
  paymentStatus       PaymentStatus?         @default(PENDING)
  taxAmount           Decimal?               @default(0) @db.Decimal(12, 2)
  baseAmount          Decimal?               @default(0) @db.Decimal(12, 2)
  ratePlanId          String?
  cancelledAt         DateTime?
  refundAmount        Decimal?               @default(0) @db.Decimal(12, 2)
  adults              Int                    @default(2)
  children            Int                    @default(0)
  extraBedCharges     Decimal?               @default(0) @db.Decimal(12, 2)
  extraBeds           Int                    @default(0)
  extraGuestCharges   Decimal?               @default(0) @db.Decimal(12, 2)
  mealCharges         Decimal?               @default(0) @db.Decimal(12, 2)
  pricingType         String?                @default("STANDARD")
  roomPrice           Decimal?               @default(0) @db.Decimal(12, 2)
  metadata            Json?                  @default("{}")
  requestId           String?                @unique
  couponCode          String?
  sessionId           String?
  hotel               Hotel                  @relation(fields: [hotelId], references: [id])
  ratePlan            RatePlan?              @relation(fields: [ratePlanId], references: [id])
  roomType            RoomType               @relation(fields: [roomTypeId], references: [id])
  session             SessionLog?            @relation(fields: [sessionId], references: [sessionId])
  user                User?                  @relation(fields: [userId], references: [id])
  invoice             Invoice?
  refund              Refund?
  review              Review?
  timelineEvents      BookingTimelineEvent[]
  bookingRooms        BookingRoom[]
  stayRequests        StayRequest[]
  intelligence        BookingIntelligence?
  /// NIGHTLY (dates) or HOURLY (a time slot on one day: slotStart to slotEnd, hours long)
  stayType            String                 @default("NIGHTLY")
  slotStart           DateTime?
  slotEnd             DateTime?
  hours               Int?

  @@index([hotelId])
  @@index([userId])
  @@index([checkIn, checkOut])
  @@index([stayType, roomTypeId, slotStart])
  @@index([status])
}

/// One room of a booking: its room type and plan (rooms of one booking can differ), who stays in it
/// and its share of the price. Booking keeps the totals (rooms, adults, children, amounts) and the
/// first room's type and plan. Bookings made before this table have no rows here.
model BookingRoom {
  id                String    @id @default(uuid())
  bookingId         String
  roomNumber        Int
  roomTypeId        String
  ratePlanId        String?
  adults            Int       @default(1)
  children          Int       @default(0)
  guestName         String
  roomPrice         Decimal   @default(0) @db.Decimal(12, 2)
  extraGuestCharges Decimal   @default(0) @db.Decimal(12, 2)
  mealCharges       Decimal   @default(0) @db.Decimal(12, 2)
  extraBedCharges   Decimal   @default(0) @db.Decimal(12, 2)
  subtotal          Decimal   @default(0) @db.Decimal(12, 2)
  /// Set when this one room was cancelled (the rest of the booking stays); its rooms are back on sale
  cancelledAt       DateTime?
  /// Refunded to the guest for this room when it was cancelled
  refundAmount      Decimal?  @db.Decimal(12, 2)
  createdAt         DateTime  @default(now())
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType          RoomType  @relation(fields: [roomTypeId], references: [id])
  ratePlan          RatePlan? @relation(fields: [ratePlanId], references: [id])

  @@unique([bookingId, roomNumber])
  @@index([roomTypeId])
}

/// A guest's request to the hotel about a booking (late arrival, early check-in, airport pickup…).
/// The hotel confirms or declines it with a reply; both sides are told by email and notification.
model StayRequest {
  id            String    @id @default(uuid())
  bookingId     String
  hotelId       String
  userId        String?
  /// LATE_ARRIVAL, EARLY_CHECKIN, LATE_CHECKOUT, AIRPORT_PICKUP, AIRPORT_DROP, PARKING, SPECIAL_OCCASION, OTHER
  type          String
  details       String    @default("")
  /// Arrival / flight / check-in time the guest gave, as typed ("23:30", "6E 512 at 10:40")
  requestedTime String?
  /// PENDING, CONFIRMED, DECLINED, CANCELLED
  status        String    @default("PENDING")
  hotelReply    String?
  respondedAt   DateTime?
  respondedBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, status])
  @@index([bookingId])
}

model TaxRule {
  id            String    @id @default(uuid())
  name          String
  minThreshold  Decimal?  @default(0) @db.Decimal(12, 2)
  maxThreshold  Decimal?  @db.Decimal(12, 2)
  percentage    Float
  isActive      Boolean?  @default(true)
  effectiveFrom DateTime  @default(now())
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt
}

model Agreement {
  id              String           @id @default(uuid())
  hotelId         String           @unique
  ownerId         String
  status          AgreementStatus? @default(DRAFT)
  /// Set by ZivoPlus for each property (no automatic default)
  commissionRate  Float?
  documentUrl     String?
  ipAddress       String?
  sentAt          DateTime?
  signedAt        DateTime?
  expiryAt        DateTime?
  createdAt       DateTime?        @default(now())
  updatedAt       DateTime?        @updatedAt
  /// Agreement number shown on the document, e.g. ZIV-AGR-2026-000012
  reference       String?          @unique
  /// Template version it was prepared from (Admin → Agreement template)
  templateVersion Int?
  /// The exact agreement text sent to the owner (HTML), and its SHA-256: what the owner signs
  content         String?          @db.Text
  contentHash     String?
  payoutCycle     String?
  termMonths      Int?
  preparedAt      DateTime?
  preparedBy      String?
  viewedAt        DateTime?
  /// Electronic signature: typed name, email the one-time code went to, device
  signerName      String?
  signerEmail     String?
  signerUserAgent String?
  signatureMethod String?
}

model BankDetail {
  id                 String    @id @default(uuid())
  hotelId            String    @unique
  accountName        String
  bankName           String
  accountNumber      String
  ifscCode           String
  branchName         String?
  upiId              String?
  createdAt          DateTime? @default(now())
  updatedAt          DateTime? @updatedAt
  /// UNVERIFIED | PENDING (test deposit sent) | VERIFIED | NAME_MISMATCH | FAILED | MANUAL (to be checked against the cancelled cheque)
  verificationStatus String    @default("UNVERIFIED")
  verificationMethod String?
  verificationRef    String?
  verificationNote   String?
  /// Name the bank holds for the account (from the test deposit)
  bankHolderName     String?
  verifiedAt         DateTime?
  verifiedBy         String?
}

model Inventory {
  id             String   @id @default(uuid())
  date           DateTime
  totalRooms     Int
  bookedRooms    Int?     @default(0)
  availableRooms Int
  stopSell       Boolean  @default(false) // closed for sale on this date (bookings refused)
  roomTypeId     String
  roomType       RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
}

model AuditLog {
  id         String    @id @default(uuid())
  action     String
  entityType String
  entityId   String
  details    Json?
  userId     String
  createdAt  DateTime? @default(now())
  requestId  String?
  traceId    String? // Global correlation ID

  @@index([userId])
  @@index([createdAt, action])
  @@index([action, createdAt])
}

model SecurityLog {
  id        String    @id @default(uuid())
  type      String
  userId    String?
  ip        String
  userAgent String?
  details   Json?
  requestId String?
  createdAt DateTime? @default(now())

  @@index([ip])
  @@index([type])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  hotelId   String
  type      String // NEW_BOOKING, CANCELLED, LOW_INVENTORY, PAYOUT
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([hotelId, isRead])
  @@index([createdAt])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model AppState {
  id                      String   @id @default("singleton")
  experimentWorkerRunning Boolean  @default(false)
  globalExperimentToggle  Boolean  @default(true)
  systemMode              String   @default("NORMAL")
  updatedAt               DateTime @updatedAt
}

model OwnerProperty {
  id         String @id @default(uuid())
  commission Float? @default(15.0)
  userId     String
  hotelId    String
}

model Permission {
  id       String   @id @default(uuid())
  module   String
  canRead  Boolean? @default(true)
  canWrite Boolean? @default(false)
  userId   String
}

model Refund {
  id               String       @id @default(uuid())
  bookingId        String       @unique
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(INITIATED)
  reason           String?
  razorpayRefundId String?
  requestId        String?
  retryCount       Int          @default(0)
  lastAttemptAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  booking          Booking      @relation(fields: [bookingId], references: [id])
}

model CancellationPolicy {
  id                    String   @id @default(uuid())
  hotelId               String   @unique
  policyCode            String   @default("FREE_CANCEL_24H") // as chosen at onboarding
  freeCancellationHours Int      @default(24)
  partialRefundPercent  Float    @default(50)
  noRefundHours         Int      @default(6)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  hotel                 Hotel    @relation(fields: [hotelId], references: [id])
}

model InvoiceSequence {
  id      Int @id @default(autoincrement())
  year    Int @unique
  counter Int @default(0)
}

model Invoice {
  id         String   @id @default(uuid())
  invoiceRef String   @unique
  bookingId  String   @unique
  pdfUrl     String?
  status     String   @default("GENERATED")
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// A verified guest review of a stay (one per booking). Published reviews (APPROVED) count towards
/// the hotel's review score; clean reviews are published straight away, others wait for a Zivo
/// moderator. The hotel can reply publicly and report a review to Zivo.
model Review {
  id             String       @id @default(uuid())
  rating         Float
  title          String?
  comment        String?
  aspectRatings  Json         @default("{}") // { cleanliness, staff, comfort, location, value }: 1-5
  tags           String[]     @default([])
  photos         Json         @default("[]") // [{ url }]
  tripType       String? // BUSINESS | COUPLE | FAMILY | FRIENDS | SOLO
  bookingId      String       @unique
  userId         String
  hotelId        String
  createdAt      DateTime     @default(now())
  isVerified     Boolean      @default(true)
  editableUntil  DateTime?
  status         ReviewStatus @default(PENDING)
  publishedAt    DateTime?
  moderationNote String? // why it was held or rejected (shown to the guest when rejected)
  moderatedById  String?
  moderatedAt    DateTime?
  reply          String?
  replyAt        DateTime?
  replyById      String?
  reportedAt     DateTime?
  reportReason   String?
  reportedById   String?
  reportResolved Boolean      @default(false)
  updatedAt      DateTime     @updatedAt
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel          Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hotelId, status])
  @@index([status])
}

model Coupon {
  id               String        @id @default(uuid())
  code             String        @unique
  discountType     String
  value            Decimal       @db.Decimal(12, 2)
  expiry           DateTime
  isActive         Boolean       @default(true)
  maxUses          Int?
  usedCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  maxDiscount      Decimal?      @db.Decimal(12, 2)
  minBookingAmount Decimal?      @db.Decimal(12, 2)
  maxUsesPerUser   Int?
  usages           CouponUsage[]
}

model CouponUsage {
  id        String @id @default(uuid())
  userId    String
  couponId  String
  usedCount Int    @default(0)
  coupon    Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
}

model LoyaltyWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBehavior {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  lastSearchedCity          String?
  lastSearchAt              DateTime?
  preferredMinPrice         Float?
  preferredMaxPrice         Float?
  lastViewedHotels          String[]
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  recentlyRecommendedHotels String[]  @default([])
}

model AnalyticsEvent {
  id           String    @id @default(uuid())
  userId       String?
  sessionId    String
  eventType    EventType
  metadata     Json
  hotelId      String?
  city         String?
  createdAt    DateTime  @default(now())
  experiments  Json?
  experimentId String?
  variantId    String?

  @@index([eventType, createdAt])
  @@index([userId])
  @@index([hotelId])
}

model HotelView {
  id        String   @id @default(uuid())
  userId    String?
  hotelId   String
  createdAt DateTime @default(now())

  @@index([hotelId, createdAt])
}

model Experiment {
  id               String    @id @default(uuid())
  name             String    @unique
  status           String
  variants         Json
  createdAt        DateTime  @default(now())
  category         String
  concludedAt      DateTime?
  endAt            DateTime?
  owner            String?
  startAt          DateTime?
  traffic          Int       @default(100)
  updatedAt        DateTime  @updatedAt
  winner           String?
  priority         String    @default("LOW")
  lastEvaluationAt DateTime?
  lastUplift       Float?
  guardrailMetrics Json?
  stratification   Json?
}

model ExperimentInsight {
  id             String   @id @default(uuid())
  experimentId   String
  experimentName String
  category       String
  winner         String?
  relativeUplift Float
  absoluteUplift Float
  confidence     String
  createdAt      DateTime @default(now())
  resultType     String
  segmentKey     String?
  status         String   @default("ACTIVE")
  version        Int      @default(1)
}

/// Dynamic pricing rule of a property (set by the owner in the extranet or by an admin).
/// type: WEEKDAY | OCCUPANCY | LAST_MINUTE | EARLY_BIRD | DATE_RANGE. adjustment is a percentage
/// (+15 = 15% up, -10 = 10% down) on the rate plan's base price; matching rules add up and the
/// total is held within the property's DynamicPricingSetting limits.
model PricingRule {
  id          String   @id @default(uuid())
  hotelId     String?
  roomTypeId  String?
  ratePlanId  String?
  name        String   @default("")
  type        String
  condition   Json
  adjustment  Float
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hotelId])
}

/// A promotion (discount) a guest gets at checkout.
///  - hotelId set: the property's own promotion (owner or admin), on its room types / rate plans.
///  - hotelId null: a Zivo platform promotion (admin), for all properties or those in hotelIds.
/// No code = applied automatically to every eligible booking and shown in search and on the hotel
/// page; with a code = only when the guest enters it. One promotion per booking: the biggest
/// discount the guest is eligible for. fundedBy decides who bears the discount in the settlement:
/// HOTEL (lower payout) or ZIVO (the hotel is paid as if there were no discount).
model Promotion {
  id               String                @id @default(uuid())
  hotelId          String?
  hotelIds         String[]              @default([])
  name             String
  description      String?
  code             String?               @unique
  discountType     String                @default("PERCENT") // PERCENT | FLAT
  value            Decimal               @db.Decimal(12, 2)
  maxDiscount      Decimal?              @db.Decimal(12, 2)
  minBookingAmount Decimal?              @db.Decimal(12, 2)
  roomTypeIds      String[]              @default([])
  ratePlanIds      String[]              @default([])
  stayStart        DateTime?
  stayEnd          DateTime?
  bookStart        DateTime?
  bookEnd          DateTime?
  minNights        Int                   @default(1)
  // Also discounts hourly stays (off by default: offers were made for nights)
  forHourly        Boolean               @default(false)
  minAdvanceDays   Int?
  maxAdvanceDays   Int?
  usageLimit       Int?
  perUserLimit     Int?
  firstBookingOnly Boolean               @default(false)
  audience         String                @default("ALL") // ALL | MEMBERS (any member) | a paid plan code (e.g. PRIME)
  fundedBy         String                @default("HOTEL") // HOTEL | ZIVO
  isActive         Boolean               @default(true)
  createdById      String?
  createdByRole    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  redemptions      PromotionRedemption[]

  @@index([hotelId])
  @@index([isActive])
}

/// A promotion used on a booking (one per booking). Counts towards the promotion's limits unless
/// the booking was cancelled.
model PromotionRedemption {
  id             String    @id @default(uuid())
  promotionId    String
  bookingId      String    @unique
  userId         String?
  hotelId        String
  discountAmount Decimal   @db.Decimal(12, 2)
  fundedBy       String
  createdAt      DateTime  @default(now())
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([userId])
}

/// Dynamic pricing switch and limits per property. Prices it works out are saved as daily rates
/// (source DYNAMIC) so search, the hotel page and checkout all charge the same price; manual and
/// channel-manager rates are never overwritten.
model DynamicPricingSetting {
  hotelId        String    @id
  enabled        Boolean   @default(false)
  minPercent     Float     @default(-30)
  maxPercent     Float     @default(50)
  minPrice       Decimal?  @db.Decimal(12, 2)
  maxPrice       Decimal?  @db.Decimal(12, 2)
  applyHolidays  Boolean   @default(true)
  horizonDays    Int       @default(90)
  lastRunAt      DateTime?
  lastRunSummary Json?
  updatedById    String?
  updatedAt      DateTime  @updatedAt
}

model DemandSignal {
