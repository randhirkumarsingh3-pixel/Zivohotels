  syncStatus        String    @default("ACTIVE")
  lastSyncAt        DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  hotel             Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  // One row per room type (zivoRatePlanId null) and one per rate plan, each with the channel
  // manager's code
  @@unique([hotelId, externalProvider, zivoRoomTypeId, zivoRatePlanId])
  @@index([hotelId, externalProvider, externalRoomCode])
}

model Transaction {
  id         String   @id @default(uuid())
  bookingId  String?
  userId     String?
  type       String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("INR")
  status     String
  gateway    String?
  gatewayRef String?  @unique
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([gatewayRef])
}

model Settlement {
  id                  String    @id @default(uuid())
  bookingId           String    @unique
  hotelId             String
  grossAmount         Decimal   @db.Decimal(12, 2)
  commissionAmount    Decimal   @db.Decimal(12, 2)
  taxAmount           Decimal   @db.Decimal(12, 2)
  netPayable          Decimal   @db.Decimal(12, 2)
  kind                String    @default("STAY") // STAY | CANCELLATION | NO_SHOW
  commissionGstAmount Decimal   @default(0) @db.Decimal(12, 2) // GST on commission (cgst + sgst + igst)
  tcsAmount           Decimal   @default(0) @db.Decimal(12, 2) // TCS (GST s.52)
  tdsAmount           Decimal   @default(0) @db.Decimal(12, 2) // TDS (income tax s.194-O)
  status              String
  version             Int       @default(1)
  holdUntil           DateTime? // Payout eligibility date
  payoutDate          DateTime?
  createdAt           DateTime  @default(now())
  cgstAmount          Decimal   @default(0) @db.Decimal(12, 2)
  igstAmount          Decimal   @default(0) @db.Decimal(12, 2)
  placeOfSupply       String?
  sgstAmount          Decimal   @default(0) @db.Decimal(12, 2)
  /// The monthly commission tax invoice that covers this stay (FinanceDocument), once issued
  invoiceId           String?
  /// The rates used when the stay was settled: { commissionPercent, commissionGstPercent,
  /// tcsPercent, tdsPercent } (Admin → Finance settings can change them for later stays)
  rates               Json?

  @@index([hotelId])
  @@index([status])
  @@index([invoiceId])
}

model LedgerEntry {
  id            String   @id @default(uuid())
  referenceId   String
  referenceType String? // BOOKING, SETTLEMENT, REFUND, DISPUTE, PAYOUT
  traceId       String? // UUID for tracking the entire request lifecycle
  account       String
  type          String // DEBIT, CREDIT
  amount        Decimal  @db.Decimal(12, 2)
  description   String
  hash          String? // Immutable hash (previous + current)
  createdAt     DateTime @default(now())
  periodId      String?

  @@unique([referenceId, account, type, amount, description])
  @@index([referenceId])
  @@index([account])
  @@index([createdAt])
}

model Payout {
  id          String   @id @default(uuid())
  hotelId     String
  totalAmount Decimal  @db.Decimal(12, 2)
  status      String
  reference   String?  @unique
  createdAt   DateTime @default(now())

  @@index([hotelId])
}

model Dispute {
  id            String   @id @default(uuid())
  transactionId String
  bookingId     String
  amount        Decimal  @db.Decimal(12, 2)
  reason        String
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([transactionId])
  @@index([bookingId])
}

model FinancialPeriod {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String?             @unique
  hotelId      String?             @unique
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  creditLimit  Decimal             @default(0) @db.Decimal(12, 2)
  currency     String              @default("INR")
  updatedAt    DateTime            @updatedAt
  kycStatus    String              @default("PENDING")
  tier         String              @default("BRONZE")
  transactions WalletTransaction[]
}

/// A movement on a wallet (Zivo Cash for guests). category says why:
///  REFUND           refund of a cancelled booking the guest chose to receive as Zivo Cash
///  BOOKING_PAYMENT  Zivo Cash used to pay for a booking (debit)
///  PAYMENT_RETURNED Zivo Cash returned when that booking was cancelled or never completed
///  ADMIN_CREDIT / ADMIN_DEBIT  goodwill or correction by a Zivo admin, with a reason
model WalletTransaction {
  id           String   @id @default(uuid())
  walletId     String
  type         String // CREDIT | DEBIT
  amount       Decimal  @db.Decimal(12, 2)
  reference    String
  category     String   @default("OTHER")
  description  String?
  bookingId    String?
  balanceAfter Decimal? @db.Decimal(12, 2)
  createdById  String?
  createdAt    DateTime @default(now())
  wallet       Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([bookingId])
}

model FraudLog {
  id        String   @id @default(uuid())
  userId    String?
  bookingId String?
  riskScore Float
  reason    String
  status    String
  createdAt DateTime @default(now())
}

model PayoutQueue {
  id        String   @id @default(uuid())
  hotelId   String
  amount    Decimal  @db.Decimal(12, 2)
  status    String
  retries   Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  holdUntil DateTime @default(now())
}

model EmailOTP {
  id         String    @id @default(uuid())
  /// Where the code was sent: an email address, or a phone number (+91...) when channel is SMS
  email      String
  /// EMAIL or SMS
  channel    String    @default("EMAIL")
  /// VERIFY (property onboarding), SIGNUP, LOGIN, PHONE (add a phone to an account)
  purpose    String    @default("VERIFY")
  otpHash    String
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  expiresAt  DateTime
  verifiedAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([email, purpose])
}

/// In-app notifications for one person (guests, admins). Hotels use Notification (by hotel).
model UserNotification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  /// Page to open when clicked, e.g. /my-bookings
  link      String?
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

/// Zivo Rewards points ledger (one row per movement). Balance = sum of AVAILABLE rows.
///  EARN    +points for a stay: PENDING until check-out, then AVAILABLE; REVERSED if cancelled.
///  REDEEM  -points used at checkout: AVAILABLE; REVERSED (= returned) if the booking is cancelled.
///  BONUS   +points (published review, sign-up) / ADJUST +/- by an admin, with a reason.
///  EXPIRE  -points left from a batch that reached its expiry (points are used oldest first).
///  VOID    rows from before Zivo Rewards (awarded on unpaid / cancelled bookings), not counted.
model LoyaltyPoint {
  id             String    @id @default(uuid())
  userId         String
  points         Int
  source         String
  type           String    @default("EARN")
  status         String    @default("AVAILABLE")
  bookingId      String?
  reviewId       String?
  description    String?
  createdById    String?
  /// When the points became usable; they expire expiryMonths (LoyaltySetting) later
  availableAt    DateTime?
  /// When the guest was emailed that these points are about to expire
  expiryNoticeAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([userId, status])
  @@index([bookingId])
}

/// Membership plans (Admin -> Membership). Every signed-in guest is on the free plan (isFree);
/// paid plans are bought for durationDays. benefits (JSON):
///   hotelMemberRates    member prices from hotels that opted in (hotel-funded)
///   zivoDiscountPercent extra discount Zivo pays for (hotel paid the full price), capped by zivoDiscountMax
///   pointsMultiplier    extra Zivo Rewards points (on top of the tier multiplier)
///   memberOffers        can use promotions for members / this plan
///   freeCancelExtraHours free cancellation this many hours past the hotel's deadline (Zivo pays the fee)
///   prioritySupport     bookings flagged for priority support
model MembershipPlan {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  description  String?
  price        Decimal      @default(0) @db.Decimal(12, 2)
  durationDays Int          @default(365)
  isFree       Boolean      @default(false)
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  benefits     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

/// A guest's paid plan for a period. PENDING_PAYMENT while paying online; ACTIVE until endsAt.
model Membership {
  id                String         @id @default(uuid())
  userId            String
  planId            String
  status            String         @default("PENDING_PAYMENT") // PENDING_PAYMENT | ACTIVE | EXPIRED | CANCELLED
  startsAt          DateTime?
  endsAt            DateTime?
  pricePaid         Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod     String? // WALLET | RAZORPAY | ADMIN
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?
  note              String?
  reminderSentAt    DateTime?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  plan              MembershipPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([endsAt])
}

