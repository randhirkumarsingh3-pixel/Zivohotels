enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  RETRY
}

model BackgroundJob {
  id          String    @id @default(uuid())
  queue       String
  jobType     String
  payload     Json
  priority    Int       @default(5)
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedBy    String?
  lockedAt    DateTime?
  runAt       DateTime  @default(now())
  completedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, queue, runAt])
  @@index([priority])
}

/// Rooms for hourly use on one day for a room type, when it differs from RoomType.hourlyRooms
/// (more, fewer, or closed for hourly stays that day).
model HourlyAllocation {
  id         String   @id @default(uuid())
  roomTypeId String
  date       DateTime @db.Date
  rooms      Int
  stopSell   Boolean  @default(false)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
}

/// A role: a named set of permissions (constants/permissions.js). scope ADMIN = ZivoPlus staff
/// (admin console), EXTRANET = a hotel's team. Ready-made roles have a key and isSystem (can't be
/// edited or deleted). Custom extranet roles belong to the hotel owner who made them (ownerId).
model AccessRole {
  id          String        @id @default(uuid())
  scope       String // ADMIN | EXTRANET
  key         String?       @unique
  name        String
  description String?
  permissions String[]      @default([])
  isSystem    Boolean       @default(false)
  ownerId     String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     StaffMember[]

  @@index([scope, ownerId])
}

/// A person's role: in the admin console (scope ADMIN, no hotel) or at one property (scope
/// EXTRANET, hotelId). A hotel's owner (Hotel.ownerId) has every extranet permission there without
/// a row. PAUSED members keep their row but have no access.
model StaffMember {
  id          String     @id @default(uuid())
  userId      String
  roleId      String
  scope       String // ADMIN | EXTRANET
  hotelId     String?
  status      String     @default("ACTIVE") // ACTIVE | PAUSED
  invitedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation("StaffUser", fields: [userId], references: [id], onDelete: Cascade)
  role        AccessRole @relation(fields: [roleId], references: [id])
  hotel       Hotel?     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, hotelId])
  @@index([hotelId])
  @@index([roleId])
}

/// Commission tax invoices and credit notes ZivoPlus issues to hotels (one invoice per hotel per
/// month; credit notes against an invoice). Everything printed is kept as it was when issued
/// (supplier, recipient, lines), so a document never changes after it is issued.
model FinanceDocument {
  id            String    @id @default(uuid())
  /// INVOICE | CREDIT_NOTE
  kind          String
  /// e.g. ZPC/2026-27/000001 (TEST-ZPC/… before live invoicing is switched on)
  number        String    @unique
  series        String
  seq           Int
  live          Boolean   @default(false)
  hotelId       String
  /// Month covered, YYYY-MM
  period        String
  issueDate     DateTime  @default(now())
  placeOfSupply String?
  supplier      Json
  recipient     Json
  /// Booking-wise lines (annexure)
  lines         Json
  stays         Int       @default(0)
  bookingValue  Decimal   @default(0) @db.Decimal(14, 2)
  taxable       Decimal   @default(0) @db.Decimal(14, 2)
  cgst          Decimal   @default(0) @db.Decimal(14, 2)
  sgst          Decimal   @default(0) @db.Decimal(14, 2)
  igst          Decimal   @default(0) @db.Decimal(14, 2)
  total         Decimal   @default(0) @db.Decimal(14, 2)
  /// Credit notes: the invoice they reduce, and why
  originalId    String?
  reason        String?
  /// ISSUED
  status        String    @default("ISSUED")
  emailedAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([hotelId, period])
  @@index([kind, period])
}

/// Running number per series and financial year, e.g. "ZPC/2026-27" -> 41
model DocumentSequence {
  series  String @id
  counter Int    @default(0)
}

/// Money owed to (positive) or by (negative) a hotel outside a stay's settlement, e.g. commission
/// given back with a credit note. Included in the hotel's next payout.
model HotelAdjustment {
  id         String   @id @default(uuid())
  hotelId    String
  amount     Decimal  @db.Decimal(12, 2)
  reason     String
  documentId String?
  /// PENDING | PAID
  status     String   @default("PENDING")
  payoutId   String?
  createdAt  DateTime @default(now())

  @@index([hotelId, status])
}

/// One guest search (Admin → Revenue per search, Demand forecasting). Repeats of the same search in
/// the same visit within 30 minutes (filters, sorting, paging) are counted once.
model SearchLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  sessionId String?
  userId    String?
  place     String
  checkIn   DateTime @db.Date
  nights    Int
  guests    Int
  rooms     Int
  results   Int
  hourly    Boolean  @default(false)

  @@index([createdAt])
  @@index([checkIn])
  @@index([place, createdAt])
}
